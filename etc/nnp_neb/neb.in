# Simulation variables
variable log_step equal 100
variable fix_h_low equal 2.0
# Structure inputs
units metal
boundary p p f
atom_modify id yes map array
# Read data
variable path_initial string "initial.dat"
variable path_final string "final.dat"
read_data ${path_initial}
mass 1 28.0855
mass 2 14.0067
mass 3 1.0078
mass 4 14.007
# Potential
pair_style nn/intel
variable    path_potential  string  "/data2/andynn/SiN_etch/dump/potential_0"
pair_coeff * * ${path_potential} Si N H F
# Pair calculation
neighbor 2 bin
neigh_modify every 1 delay 0 check no
compute 	_rg all gyration
# Setting fixed region
region      rfix       block   EDGE EDGE  EDGE EDGE  EDGE ${fix_h_low} units box
group       gfix       region  rfix
velocity    gfix       set     0.0 0.0 0.0
fix         fix_bot    gfix    setforce 0.0 0.0 0.0

group       gmove      subtract     all     gfix
# calculation balance
fix f_balance all balance 0 1.05 shift xyz 20 1.05 weight time 1
# neb syntax: neb etol ftol N1 N2 Nevery file-style arg keyword values
# file-style : final / each / none
# keyword = verbosity ( verbose / default / terse )
fix neb_set gmove neb 5.0 parallel neigh
min_style quickmin
variable i equal part

# the initial and final image should not move
if "${i} == 0 || ${i} == 27" then &
    "fix         fix_all    all    setforce 0.0 0.0 0.0"

dump dMovie all custom ${log_step} dump_${i}.lammps &
 id element x y z vx vy vz fx fy fz # Dump file
dump_modify dMovie element Si N H F
dump_modify dMovie sort id time yes append yes
dump_modify dMovie format line &
 "%3d %2s %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f"
# neb 0 0.01 3000 1000 1 final ${path_final}
neb 0 0.01 3000 1000 1 each coords.initial.${i}
