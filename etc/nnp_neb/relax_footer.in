# Potential
# pair_style hybrid/overlay nn/intel   d2 15 0.75 20 zbl/pair
pair_style hybrid/overlay nn/intel zbl/pair
variable    path_potential  string  "my_potential"
pair_coeff * * nn/intel ${path_potential} my_atom_order

# pair_coeff 1 1 d2 95.65972    3.4320
# pair_coeff 1 2 d2 34.9204616  3.1130
# pair_coeff 1 3 d2 11.7807588  2.7170
# pair_coeff 1 4 d2 27.2687204  3.0030
# pair_coeff 2 2 d2 12.74772    2.7940
# pair_coeff 2 3 d2 4.30106     2.3980
# pair_coeff 2 4 d2 9.954622    2.6840
# pair_coeff 3 3 d2 1.45096     2.0020
# pair_coeff 3 4 d2 3.357936    2.2880
# pair_coeff 4 4 d2 7.77300     2.5740

pair_coeff  1 1  zbl/pair    14 14    1.94 2.05
pair_coeff  1 2  zbl/pair    14 7     1.34 1.42
pair_coeff  1 3  zbl/pair    14 1     1.31 1.39
pair_coeff  1 4  zbl/pair    14 9     1.39 1.47
pair_coeff  2 2  zbl/pair    7 7      0.95 1.00
pair_coeff  2 3  zbl/pair    7 1      0.89 0.95
pair_coeff  2 4  zbl/pair    7 9      1.14 1.21
pair_coeff  3 3  zbl/pair    1 1      0.64 0.68
pair_coeff  3 4  zbl/pair    1 9      0.80   0.84
pair_coeff  4 4  zbl/pair    9 9      1.21 1.28

# Pair calculation
neighbor 2 bin
neigh_modify every 1 delay 0 check no
compute _rg all gyration
# Setting fixed region
region      rfix       block   EDGE EDGE  EDGE EDGE  EDGE ${fix_h_low} units box
group       gfix       region  rfix
velocity    gfix       set     0.0 0.0 0.0
fix         fix_bot    gfix    setforce 0.0 0.0 0.0

# calculation balance
fix         f_balance  all  balance 0 1.05 shift xyz 20 1.05 weight time 1
# Set dump
dump        dMovie  all     custom ${log_step}    dump.lammps &
           id element x y z vx vy vz fx fy fz # Dump file
dump_modify dMovie  element  my_atom_order
dump_modify dMovie  sort id  time yes
dump_modify dMovie  format line &
            "%3d %2s %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f %10.5f"
# Minimize
min_style   cg
minimize    0 0.01 100000 100000
# Write final data
write_data  FINAL.coo
